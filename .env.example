# ---- LLM (required) ----
OPENAI_API_KEY=your-openai-key-here
LLM_MODEL=gpt-4o-mini
# Optional: any OpenAI-compatible provider (Groq, Gemini, Ollama, OpenRouter)
# LLM_BASE_URL=https://api.groq.com/openai/v1

# ---- LangSmith tracing (optional) ----
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=your-langsmith-key-here
LANGSMITH_PROJECT=maa-wellness-support
LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# ---- Neo4j knowledge graph ----
# Local dev without Docker: bolt://localhost:7687 ; inside docker compose this is overridden to bolt://neo4j:7687
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=change-me-strong-password
GRAPH_ENABLED=true

# ---- Retrieval tuning (optional) ----
# EMBED_MODEL=BAAI/bge-small-en-v1.5
# RERANK_MODEL=Xenova/ms-marco-MiniLM-L-6-v2
# RERANK_MIN_SCORE=-2.0

